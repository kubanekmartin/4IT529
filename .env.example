# Vzor .env pro docker compose. Zkopíruj na .env (je v .gitignore) a doplň hodnoty.
# Hesla generuj třeba `openssl rand -hex 24`, aby šla bez úprav do URL databáze.
# Na serveru má .env práva 600. Skutečné hodnoty nikdy do repa ani do chatu.

# Heslo vlastníka databáze (migrace a agenti)
POSTGRES_PASSWORD=
# Heslo role webu, která smí jen číst
WEB_DB_PASSWORD=
# Klíč Claude API (jen na serveru; agenti bez LLM ho nepotřebují)
ANTHROPIC_API_KEY=

# Volitelné, výchozí hodnoty jsou v compose.yaml:
# POSTGRES_USER=
# POSTGRES_DB=
# WEB_DB_USER=
# WEB_HOST_PORT=
# POSTGRES_HOST_PORT=
# IMAGE_TAG=
# Model LLM pro všechny agenty, nebo pro jednoho agenta (LLM_MODEL_<AGENT>):
# LLM_MODEL=
# LLM_MODEL_ANALYTICKY=
